{
  "name": "hearth",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "vite --host",
    "dev:server": "tsx watch scripts/dev-server.ts",
    "dev:seed": "tsx scripts/seed-dev.ts",
    "build": "npm run build:client && npm run build:server && npm run build:demo && npm run build:reset-password && npm run build:end-all-sessions && node scripts/gen-version.mjs",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "build:demo": "esbuild scripts/demo-server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/demo-server.js",
    "build:reset-password": "esbuild scripts/reset-owner-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/reset-owner-password.js",
    "build:end-all-sessions": "esbuild scripts/end-all-sessions.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/end-all-sessions.js",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:client && playwright test",
    "test:e2e:ui": "npm run build:client && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate-from-sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "backup:decrypt": "tsx scripts/decrypt-backup.ts",
    "reset-owner-password": "tsx scripts/reset-owner-password.ts",
    "end-all-sessions": "tsx scripts/end-all-sessions.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/helmet": "^13.1.2",
    "@fastify/static": "^10.1.5",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@mantine/charts": "^9.7.1",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@microcharts/react": "^0.19.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.18.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "lucide-react": "^1.53.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
