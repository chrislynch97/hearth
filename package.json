{
  "name": "hearth",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "vite --host",
    "dev:server": "tsx watch scripts/dev-server.ts",
    "build": "npm run build:client && npm run build:server && npm run build:demo && npm run build:reset-password && node scripts/gen-version.mjs",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "build:demo": "esbuild scripts/demo-server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/demo-server.js",
    "build:reset-password": "esbuild scripts/reset-owner-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/reset-owner-password.js",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate-from-sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "backup:decrypt": "tsx scripts/decrypt-backup.ts",
    "reset-owner-password": "tsx scripts/reset-owner-password.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^9.1.3",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@fontsource/spectral": "^5.2.8",
    "@mantine/charts": "^9.4.0",
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@mantine/notifications": "^9.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "superjson": "^2.2.6",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
