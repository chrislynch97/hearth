{
  "name": "hearth",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "vite --host",
    "dev:server": "tsx watch scripts/dev-server.ts",
    "dev:seed": "tsx scripts/seed-dev.ts",
    "build": "npm run build:client && npm run build:server && npm run build:demo && npm run build:reset-password && npm run build:end-all-sessions && node scripts/gen-version.mjs",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "build:demo": "esbuild scripts/demo-server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/demo-server.js",
    "build:reset-password": "esbuild scripts/reset-owner-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/reset-owner-password.js",
    "build:end-all-sessions": "esbuild scripts/end-all-sessions.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/end-all-sessions.js",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:client && playwright test",
    "test:e2e:ui": "npm run build:client && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate-from-sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "backup:decrypt": "tsx scripts/decrypt-backup.ts",
    "reset-owner-password": "tsx scripts/reset-owner-password.ts",
    "end-all-sessions": "tsx scripts/end-all-sessions.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@mantine/charts": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@microcharts/react": "^0.18.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "superjson": "^2.2.6",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
