{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:client"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 8787
    },
    {
      "name": "wizard-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "env": { "DATABASE_URL": "pglite:./data/wizard-check" },
      "port": 8787
    },
    {
      "name": "demo-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "demo"],
      "port": 8787
    },
    {
      "name": "demo-mail",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "demo"],
      "env": {
        "HEARTH_MAIL_TRANSPORT": "log",
        "HEARTH_MAIL_FROM": "Hearth <hearth@example.com>",
        "HEARTH_PUBLIC_URL": "http://localhost:5173"
      },
      "port": 8787
    }
  ]
}
